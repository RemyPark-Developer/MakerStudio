# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채워주세요.
# .env.local은 .gitignore에 이미 포함되어 있어 절대 GitHub에 올라가지 않습니다.

# Anthropic API 키 (서버에서만 사용, 브라우저에는 절대 노출되지 않음)
ANTHROPIC_API_KEY=

# Supabase (lib/supabase/server.ts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Solapi 문자 발송 (lib/sms/solapi.ts) — solapi.com 가입 후 발급
# 초등학생 회원가입의 보호자 인증(§3.2 법적 요건)에 실제로 사용됩니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# Resend 이메일 발송 (lib/email/resend.ts) — resend.com 가입 후 발급
# 회원가입 시 이메일 실제 소유 확인에 사용됩니다.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# 배포된 사이트의 실제 URL (이메일 인증 링크가 여기로 돌아옵니다)
# 로컬 개발 시: http://localhost:3000 (또는 Codespaces 포트 URL)
NEXT_PUBLIC_APP_URL=

# 포트원 결제 연동 (lib/billing/portone.ts, app/checkout) — portone.io 가입 후 발급
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# 아래 두 값은 NEXT_PUBLIC_ 접두사라 브라우저에 노출됩니다 — 원래 그렇게 쓰도록 설계된 값입니다.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
